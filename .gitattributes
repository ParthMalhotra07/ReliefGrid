# Normalize all text files to LF on commit (Linux/WSL development).
# Binary files are left unchanged.
* text=auto eol=lf
*.go        text eol=lf
*.sh        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.mod       text eol=lf
*.sum       text eol=lf
*.toml      text eol=lf
Makefile    text eol=lf
# Binary
*.pdf       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.svg       binary

# Preserve the supplied editorial handout exactly; hashes bind its original whitespace.
docs/report/contributions/S-sections-v3.md whitespace=-blank-at-eol,-blank-at-eof
