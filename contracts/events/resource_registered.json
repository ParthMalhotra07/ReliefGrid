{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reliefgrid.internal/events/resource_registered.json",
  "title": "ResourceRegistered",
  "description": "Emitted when a new emergency resource is committed to the FSM.",
  "type": "object",
  "required": ["schemaVersion", "eventId", "entityId", "entityVersion", "eventType", "occurredAt"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1",
      "description": "Schema version; increment on breaking changes."
    },
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Globally unique event identifier (UUID v4)."
    },
    "entityId": {
      "type": "string",
      "format": "uuid",
      "description": "The resourceId of the registered resource."
    },
    "entityVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "FSM entity version after this event was applied."
    },
    "eventType": {
      "type": "string",
      "const": "resource.registered",
      "description": "Discriminator for routing and deserialization."
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when the event was committed to the FSM."
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
      "description": "W3C Trace Context traceparent header value for distributed tracing."
    },
    "payload": {
      "type": "object",
      "description": "Snapshot of the resource at registration time.",
      "required": ["resourceId", "resourceType", "name", "status", "location", "disposition", "windowStart", "windowEnd"],
      "properties": {
        "resourceId":   { "type": "string", "format": "uuid" },
        "resourceType": { "type": "string" },
        "name":         { "type": "string" },
        "status":       { "type": "string", "const": "AVAILABLE" },
        "location": {
          "type": "object",
          "required": ["lat", "lng"],
          "properties": {
            "lat": { "type": "number", "minimum": -90,  "maximum": 90  },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "disposition":  { "type": "string" },
        "operatorId":   { "type": "string" },
        "windowStart":  { "type": "string", "format": "date-time" },
        "windowEnd":    { "type": "string", "format": "date-time" }
      }
    }
  },
  "examples": [
    {
      "schemaVersion": "1",
      "eventId": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
      "entityId": "660e8400-e29b-41d4-a716-446655440001",
      "entityVersion": 1,
      "eventType": "resource.registered",
      "occurredAt": "2026-10-21T05:50:00Z",
      "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
      "payload": {
        "resourceId": "660e8400-e29b-41d4-a716-446655440001",
        "resourceType": "MEDICAL",
        "name": "Ambulance Unit 7",
        "status": "AVAILABLE",
        "location": { "lat": 28.6200, "lng": 77.2100 },
        "disposition": "REUSABLE",
        "operatorId": "operator-xyz789",
        "windowStart": "2026-10-21T06:00:00Z",
        "windowEnd": "2026-10-22T06:00:00Z"
      }
    }
  ]
}
